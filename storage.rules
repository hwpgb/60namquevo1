rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['email1@gmail.com','email2@gmail.com'] && request.resource.size < 5 * 1024 * 1024;
    }
    match /videos/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['email1@gmail.com','email2@gmail.com'] && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
